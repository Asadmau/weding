# Server Configuration
PORT=3000
NODE_ENV=development
APP_URL="MY_APP_URL"

# Database & Storage
DB_PATH="./data/wedding.db"
UPLOAD_DIR="./uploads"

# Security & Admin Authentication
# Leave ADMIN_PASSWORD blank on first run to claim your admin password securely in the browser UI,
# or configure ADMIN_EMAIL and ADMIN_PASSWORD via environment secrets.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
SESSION_SECRET=""
SESSION_TTL_HOURS=24

# Optional AI Feature Key (server-side only)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
